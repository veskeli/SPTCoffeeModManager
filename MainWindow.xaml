<Window x:Class="SPTCoffeeModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sptCoffeeModManager="clr-namespace:SPTCoffeeModManager"
        mc:Ignorable="d"
        Title="SPT Coffee Mod Manager" Height="550" Width="1000"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushAppBackground}" Foreground="{DynamicResource BrushTextPrimary}"
        WindowStyle="None">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <sptCoffeeModManager:WindowHeader Grid.Row="0" HeaderText="SPT Coffee Mod Manager" />

        <!-- Main Content with Vertical Tab Control -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tab Buttons (Vertical) -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Background="{DynamicResource BrushSurface1}" Margin="0">

                <!-- Coffee Cup Icon -->

                <Image Source="{StaticResource IconCoffeeCup}"
                       Width="40"
                       Height="40"
                       Margin="10"
                       HorizontalAlignment="Center"/>

                <Button Name="HomeTabButton"
                        Height="40"
                        Background="{DynamicResource BrushAccent}"
                        BorderThickness="0"
                        Click="HomeTab_Click"
                        Cursor="Hand">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- HOME ICON -->
                        <Path Data="{StaticResource IconHome}"
                              Fill="{DynamicResource BrushTextPrimary}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"/>

                        <!-- HOME TEXT -->
                        <TextBlock Text="Home"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}" />

                    </StackPanel>
                </Button>
                <Button Name="ModsTabButton"
                        Height="40"
                        Background="{DynamicResource BrushSurface1}"
                        BorderThickness="0"
                        Click="ModsTab_Click"
                        Cursor="Hand">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- MODS ICON -->
                        <Image Source="{StaticResource IconMods}"
                               Width="18"
                               Height="18"/>

                        <!-- MODS TEXT -->
                        <TextBlock Text="Mods"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}" />

                    </StackPanel>
                </Button>
                <Button Name="SettingsTabButton"
                        Height="40"
                        Background="{DynamicResource BrushSurface1}"
                        BorderThickness="0"
                        Click="SettingsTab_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- SETTINGS ICON -->
                        <Image Source="{StaticResource IconSettings}"
                               Width="18"
                               Height="18"/>

                        <!-- SETTINGS TEXT -->
                        <TextBlock Text="Settings"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}" />

                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Tab Content -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushAppBackground}" Margin="5">
                <!-- Home Tab -->
                <Grid Name="HomeTabContent" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,1,2,1" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Server: " FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Name="ServerStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                            <TextBlock Name="SptServerStatusTextLabel" Text="SPT Server: " FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="10,0,8,0" />
                            <TextBlock Name="SptServerStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                            <TextBlock Name="HeadlessStatusTextLabel" Text="Headless: " FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="10,0,8,0" />
                            <TextBlock Name="HeadlessStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                            <Button Name="KillHeadlessButton" Content="K" Width="25" Margin="0,0,10,0"
                                    Background="{DynamicResource BrushDanger}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="KillServer_Click" Visibility="Collapsed"/>
                            <Button Name="RefreshButton" Content="⟳" Width="25" Height="25" Margin="0,0,10,0"
                                    Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="CheckServerButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <GroupBox Grid.Row="1" Header="Quick Status" Margin="0,10,0,15"
                              Background="{DynamicResource BrushSurface1}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <TextBlock Text="Config sync status: " Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,10,0" />
                                <TextBlock Name="SyncStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <TextBlock Text="Current SPT version: " Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,10,0" />
                                <TextBlock Name="CurrentSptVersionText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Name="StatusTextBlock" Text="" Margin="0,10,0,0" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="40" Margin="0,10,0,0">
                        <Button Name="CheckUpdatesButton" Content="Check for mod updates" Width="170" Margin="0,0,10,0"
                                Background="{DynamicResource SecondaryBrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="CheckUpdates_Click" />
                        <Button Name="LaunchOrUpdateButton" Content="Play" Width="120"
                                Background="{DynamicResource BrushAccentAlt}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="LaunchOrUpdate_Click" />
                    </StackPanel>
                </Grid>

                <!-- Mods Tab -->
                <Grid Name="ModsTabContent" Visibility="Collapsed" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Installed Mods" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="14" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Name="RefreshModsButton" Content="⟳ Refresh" Width="80" Height="25"
                                Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="CheckServerButton_Click"/>
                    </Grid>

                    <GroupBox Grid.Row="1" Header="Mod Status" Margin="0,0,0,5"
                              Background="{DynamicResource BrushSurface1}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}">
                        <ListView Name="ModListView" Height="380" Background="{DynamicResource BrushAppBackground}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Margin="0,10,0,0">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="{DynamicResource BrushAppBackground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Up to date">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Update">
                                            <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Not installed">
                                            <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Removed">
                                            <Setter Property="Background" Value="{DynamicResource BrushDangerAlt}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Downloading...">
                                            <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Extracting...">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccessAlt}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Installing...">
                                            <Setter Property="Background" Value="{DynamicResource BrushInfoAlt}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BrushSurface1}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mod Name" Width="300" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Local Version" Width="100" DisplayMemberBinding="{Binding LocalVersion}" />
                                    <GridViewColumn Header="Server Version" Width="100" DisplayMemberBinding="{Binding ServerVersion}" />
                                    <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="40" Margin="0,10,0,0">
                        <Button Name="CheckForModsButton" Content="Check for mods" Width="120"
                                Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="CheckServerButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Settings Tab -->
                <StackPanel Name="SettingsTabContent" Visibility="Collapsed" Margin="5">
                    <TextBlock Text="Settings" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="14" Margin="0,0,0,15" />
                    <GroupBox Header="Server Configuration" Margin="0,0,0,10"
                              Background="{DynamicResource BrushSurface1}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}">
                        <StackPanel Margin="10">
                            <Button Name="ConfigureServerButton" Content="Configure Server" Width="150" Height="30" Margin="0,0,0,10"
                                    Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Click="ConfigureServerButton_Click"/>
                            <TextBlock Text="Manage server connection settings and authentication" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
