<UserControl x:Class="SPTCoffeeModManager.Tabs.HomeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,1,2,1" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Server: " FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="0,0,8,0" />
                <TextBlock Name="ServerStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                <TextBlock Name="SptServerStatusTextLabel" Text="SPT Server: " FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="10,0,8,0" />
                <TextBlock Name="SptServerStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
                <TextBlock Name="HeadlessStatusTextLabel" Text="Headless: " FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="10,0,8,0" />
                <TextBlock Name="HeadlessStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="13" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                <Button Name="KillHeadlessButton" Content="K" Width="25" Margin="0,0,10,0"
                        Background="{DynamicResource BrushDanger}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Visibility="Collapsed"/>
                <Button Name="RefreshButton" Content="⟳" Width="25" Height="25" Margin="0,0,10,0"
                        Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="Quick Status" Margin="0,10,0,15"
                  Background="{DynamicResource BrushSurface1}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBlock Text="Config sync status: " Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,10,0" />
                    <TextBlock Name="SyncStatusText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBlock Text="Current SPT version: " Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,10,0" />
                    <TextBlock Name="CurrentSptVersionText" Text="Checking..." Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                </StackPanel>
                <TextBlock Name="StatusTextBlock" Text="" Margin="0,10,0,0" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="40" Margin="0,10,0,0">
            <Button Name="CheckUpdatesButton" Content="Check for mod updates" Width="170" Margin="0,0,10,0"
                    Background="{DynamicResource SecondaryBrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
            <Button Name="LaunchOrUpdateButton" Content="Play" Width="120"
                    Background="{DynamicResource BrushAccentAlt}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
        </StackPanel>
    </Grid>
</UserControl>



