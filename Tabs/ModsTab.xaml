<UserControl x:Class="SPTCoffeeModManager.Tabs.ModsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Installed Mods" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="14" VerticalAlignment="Center" />
            <Button Grid.Column="1" Name="RefreshModsButton" Content="⟳ Refresh" Width="80" Height="25"
                    Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}"/>
        </Grid>

        <GroupBox Grid.Row="1" Header="Mod Status" Margin="0,0,0,5"
                  Background="{DynamicResource BrushSurface1}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}">
            <ListView Name="ModListView" Height="380" Background="{DynamicResource BrushAppBackground}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Margin="0,10,0,0">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="{DynamicResource BrushAppBackground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Up to date">
                                <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Update">
                                <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Not installed">
                                <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource BrushDangerAlt}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Downloading...">
                                <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Extracting...">
                                <Setter Property="Background" Value="{DynamicResource BrushSuccessAlt}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Installing...">
                                <Setter Property="Background" Value="{DynamicResource BrushInfoAlt}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BrushSurface1}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Mod Name" Width="300" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Local Version" Width="100" DisplayMemberBinding="{Binding LocalVersion}" />
                        <GridViewColumn Header="Server Version" Width="100" DisplayMemberBinding="{Binding ServerVersion}" />
                        <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="40" Margin="0,10,0,0">
            <Button Name="CheckForModsButton" Content="Check for mods" Width="120"
                    Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
        </StackPanel>
    </Grid>
</UserControl>



